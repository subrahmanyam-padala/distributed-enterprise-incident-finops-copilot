# ==============================================================================
# OpsPilot - Environment Configuration Template
# Copy this file to .env and adjust values for local development
# NEVER commit the actual .env file with secrets to version control!
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot_user
POSTGRES_PASSWORD=opspilot_secret_change_in_prod

# Redis Configuration (Optional in early dev, required in reliability phase)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration (KRaft Mode)
KAFKA_BROKER=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Java Control Plane Service (Spring Boot)
CONTROL_PLANE_PORT=8080
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Python AI Triage Engine (FastAPI)
AI_TRIAGE_PORT=8000
AI_TRIAGE_HOST=0.0.0.0
LLM_PROVIDER=mock
# Optional when using real LLM provider (e.g., openai, anthropic, gemini)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# MCP Server
MCP_SERVER_PORT=8001
MCP_SERVER_HOST=0.0.0.0
MCP_AUTH_TOKEN=mcp_local_dev_token_change_in_prod

# Frontend (React + Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="OpsPilot"
