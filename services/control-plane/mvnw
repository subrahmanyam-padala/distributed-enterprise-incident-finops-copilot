#!/bin/sh
# Maven Wrapper Script for Unix
# Automatically downloads Maven if not present

set -e

MAVEN_WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(pwd)}"

distributionUrl=$(grep "^distributionUrl=" "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.9"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Maven not found. Please install Maven 3.9+ or use ./mvnw after downloading the wrapper JAR."
    echo "Download from: https://maven.apache.org/download.cgi"
    exit 1
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
